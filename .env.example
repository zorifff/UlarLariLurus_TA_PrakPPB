# Salin file ini menjadi .env lalu isi.
# Di Vercel: Project Settings > Environment Variables (atau otomatis lewat integrasi Neon).

# Connection string Neon (Neon Console > Connect). KHUSUS SERVER — jangan diberi awalan VITE_.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Opsional. Base URL API untuk axios di browser. Default: /api (domain yang sama).
# VITE_API_BASE_URL=/api
